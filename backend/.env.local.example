# Copy to .env.local for `npm run dev` (local server: SQLite files in .local/sqlite/, one database per shop like
# Turso). Set LOCAL_DB=memory for the in-memory single-database store instead (Catalyst Data Store rules).
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=change-me
AUTH_SECRET=at-least-32-random-characters-here
SETUP_KEY=at-least-16-random-characters
SECRETS_KEY=at-least-32-random-characters-for-tokens
PORT=8787
