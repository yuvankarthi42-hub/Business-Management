# Copy to .env.prod — used by `npm run build:prod` (the production web app for Slate).
VITE_BACKEND=catalyst
# The PRODUCTION api function URL (no "development" in it), ending in /server/api
VITE_API_BASE=https://<project>-<id>.catalystserverless.in/server/api
# Slate serves only real files: links look like /#/login
VITE_ROUTER=hash
# Optional: "Get started" opens WhatsApp to this number (country code + number, digits only)
# VITE_CONTACT_WHATSAPP=91XXXXXXXXXX
