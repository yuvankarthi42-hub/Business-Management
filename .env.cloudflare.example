# Copy to .env.cloudflare — used by `npm run build:cloudflare` (the web app for Cloudflare Pages, account 2).
# The app talks to the Worker exactly as to Catalyst (same client), so the backend kind stays "catalyst".
VITE_BACKEND=catalyst
# The Worker's address, ending in /server/api (API_PREFIX in backend/wrangler.toml)
VITE_API_BASE=https://api.example.com/server/api
# Optional: "Get started" opens WhatsApp to this number (country code + number, digits only)
# VITE_CONTACT_WHATSAPP=91XXXXXXXXXX
