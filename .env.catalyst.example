# Copy to .env.catalyst — used by `npm run build:catalyst` and `npm run dev:catalyst`.
VITE_BACKEND=catalyst
# Where the API is. Same site as the app (web client hosting / local dev proxy): /server/api
# App on Slate (another domain): the full function URL, e.g. https://<project>-<id>.development.catalystserverless.in/server/api
VITE_API_BASE=/server/api
# Slate: links like /#/login (Slate serves only real files)
# VITE_ROUTER=hash
